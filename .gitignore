# ─────────────────────────────────────────────────────────────────────────────
# Only source is tracked.  Build trees, firmware dumps, toolchain downloads and
# vendor images stay out of the repository.
# ─────────────────────────────────────────────────────────────────────────────
/*
!/.gitignore
!/LICENSE
!/AGENTS.md
!/README.md
!/TRACKING.md
!/UFS-PORTING.md
!/ENVIRONMENT.md
!/build-yunluo-mu.sh

# Boot chain sources only: the 64 MiB stock vendor_boot.img and the compiled
# BootShim are not source.
!/bootchain/
/bootchain/vendor_boot.img
/bootchain/BootShim/*.elf
/bootchain/BootShim/*.bin

# Out of the whole Mu-Silicium tree only the yunluo platform package is tracked.
# (The one Mu_Basecore file this platform patches is tracked explicitly.)
!/mu-silicium/
/mu-silicium/*
!/mu-silicium/Platforms/
/mu-silicium/Platforms/*
!/mu-silicium/Platforms/Xiaomi/
/mu-silicium/Platforms/Xiaomi/*
!/mu-silicium/Platforms/Xiaomi/yunluoPkg/

__pycache__/
*.pyc
